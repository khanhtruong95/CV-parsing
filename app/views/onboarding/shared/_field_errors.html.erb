<% messages = profile.errors[field] %>
<% if messages.present? %>
  <p class="msg-danger" role="alert">
    <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke="#B42318" stroke-width="1.6"/><path d="M10 6v5" stroke="#B42318" stroke-width="1.8" stroke-linecap="round"/><circle cx="10" cy="14" r="1" fill="#B42318"/></svg>
    <%= messages.to_sentence.capitalize %>
  </p>
<% end %>
