<% content_for(:title) { "Profile submitted — DentaMatch" } %>
<%= render "shared/progress", current_step: 2 %>

<section class="card" style="text-align:center;">
  <div style="width:56px;height:56px;margin:8px auto 20px;border-radius:999px;background:var(--primary-soft);display:flex;align-items:center;justify-content:center;">
    <svg width="26" height="26" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5l4 4 8-9" stroke="#0F766E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
  <h1>Thank you, <%= @profile.first_name %>!</h1>
  <p class="lead" style="margin:8px auto 24px;">Your candidate profile has been submitted. Our recruitment team will review it and get in touch about matching opportunities. You can close this page.</p>
</section>
