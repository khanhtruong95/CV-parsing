<%= turbo_frame_tag "cv_status", src: onboarding_cv_status_path, target: "_top" do %>
  <section class="card">
    <div class="processing"
         data-controller="cv-poll"
         data-cv-poll-status-value="<%= document&.parsing_status || "pending" %>"
         data-cv-poll-redirect-url-value="<%= onboarding_profile_path %>"
         data-cv-poll-fallback-url-value="<%= onboarding_profile_path %>">
      <div class="spinner" aria-hidden="true"></div>
      <h2>Analyzing your CV&hellip;</h2>
      <p>We're extracting your work experience, education and skills. This usually takes less than 30 seconds — please keep this page open.</p>
      <% if document&.original_filename %>
        <span class="file-pill">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 2H6a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 6 18h8a1.5 1.5 0 0 0 1.5-1.5V5.5L12 2Z" stroke="currentColor" stroke-width="1.4"/></svg>
          <%= document.original_filename %><%= " · #{number_to_human_size(document.file_size)}" if document.file_size %>
        </span>
      <% end %>
    </div>
  </section>
<% end %>
