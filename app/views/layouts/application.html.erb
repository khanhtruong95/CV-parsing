<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "DentaMatch" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="DentaMatch">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="wrap">
      <header class="site">
        <a class="wordmark" href="<%= root_path %>" aria-label="DentaMatch home">
          <svg width="26" height="26" viewBox="0 0 20 20" aria-hidden="true">
            <path fill="#0F766E" d="M7 2.5C4.7 2.5 3 4.4 3 6.8c0 1.6.6 2.7 1.1 4 .5 1.3 1 3 1.2 5.3.1 1.3.6 2.4 1.5 2.4 1.7 0 1-4.6 3.2-4.6s1.5 4.6 3.2 4.6c.9 0 1.4-1.1 1.5-2.4.2-2.3.7-4 1.2-5.3.5-1.3 1.1-2.4 1.1-4 0-2.4-1.7-4.3-4-4.3-1.2 0-1.7.6-3 .6s-1.8-.6-3-.6z"/>
          </svg>
          DentaMatch<span class="dot">.</span>
        </a>
      </header>

      <main>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
